# Copy this file to .env and fill in your own values.
# .env is never bundled into the browser build — server/liveRunner.ts is a
# plain Node script, invoked directly (npm run live), not imported by the
# Vite app. Keep it that way: never import server/liveRunner.ts or
# providers/metaapi/MetaApiBroker.ts from anything under src/pages, src/hooks,
# or src/components.

# MetaApi.cloud auth token — from https://app.metaapi.cloud/token
METAAPI_TOKEN=

# The MetaApi trading account id — from https://app.metaapi.cloud/accounts
# (create/add your MT5 account there first; use a DEMO account while testing)
METAAPI_ACCOUNT_ID=

# Optional overrides for npm run live
METAAPI_WATCHLIST=EURUSD,GBPUSD,USDJPY
METAAPI_POLL_SECONDS=60
# "true" = fire approved trades immediately, no prompt.
# "false" (default) = every approved trade asks for your y/n go-ahead.
AUTO_CONFIRM=false

# Optional overrides for npm run backtest
BACKTEST_INSTRUMENT=EURUSD
BACKTEST_TIMEFRAME=15m
BACKTEST_BARS=1500
