# Copy to .env in this folder (python-bridge/.env) and fill in as needed.

# Only needed if you have multiple MT5 installations, or if the bridge's
# startup log shows "AutoTrading enabled on THIS terminal instance: False"
# even though you've enabled it in the terminal window you're looking at —
# that means mt5.initialize() attached to a DIFFERENT installation. Find
# the exact path of the terminal you actually use (right-click its
# shortcut -> Properties -> Target, typically something like
# C:\Program Files\<Your Broker> MT5\terminal64.exe) and set it here.
MT5_TERMINAL_PATH=

# Optional: change the local port the bridge listens on (default 8787).
MT5_BRIDGE_PORT=
