# Copy this file to .env and fill in real values. Never commit .env —
# it's already covered by the top-level .gitignore pattern *.env, but
# double check before pushing anywhere.

# --- Your MT5 account (start with a DEMO account) ---------------------------
MT5_LOGIN=12345678
MT5_PASSWORD=your-mt5-password
MT5_SERVER=ICMarketsSC-Demo

# Only needed if the MT5 terminal isn't installed in its default location.
# MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe

# --- Bridge access control ----------------------------------------------
# A random secret the Analysis Engine app must send as the X-API-Key header
# on every request (except /health). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
MT5_BRIDGE_API_KEY=change-me

# --- Trading safety switch ------------------------------------------------
# Keep this false until you've hit /account, /candles, and /spread and
# confirmed the numbers look right. Only flip to true once you're ready
# for this bridge to be able to place and close real orders on the
# account above — this is a deliberate default, not a bug.
MT5_BRIDGE_ALLOW_TRADING=false

# --- Where the bridge listens --------------------------------------------
# 127.0.0.1 (default) means only this same machine can reach it. If the
# Analysis Engine app runs on a different machine, you'll need to either
# change this to 0.0.0.0 and firewall the port to just that machine's IP,
# or put a reverse proxy / VPN in front — don't expose this raw on the
# open internet.
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=8787
